# -----------------------------------------------------------------------------
# HR Flow AI — environment configuration
# Copy this file to `.env` and fill in values. `.env` is gitignored.
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# When running via docker-compose, the hostname is `db` (service name).
# When running locally against the dockerized Postgres, use `localhost:5432`.
DATABASE_URL="postgresql://hrflow:hrflow@localhost:5432/hrflow?schema=public"

# NextAuth / Auth.js secret. Generate with: `openssl rand -base64 32`
AUTH_SECRET="change-me-in-production-please-generate-a-real-secret"

# Public URL of the app (used by NextAuth for redirects).
NEXTAUTH_URL="http://localhost:3000"

# OpenAI API key. If unset, the app uses a deterministic mock generator
# so the entire product works end-to-end without external credentials.
OPENAI_API_KEY=""

# Optional: override the OpenAI model (defaults to gpt-4o-mini).
OPENAI_MODEL="gpt-4o-mini"
